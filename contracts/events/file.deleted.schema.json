{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "file.deleted",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "file.deleted"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deleted_at",
        "deletion_request_id",
        "file_id"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "format": "uuid"
        },
        "deletion_request_id": {
          "type": "string",
          "format": "uuid"
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
