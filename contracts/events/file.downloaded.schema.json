{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "file.downloaded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "file.downloaded"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "null"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_at",
        "download_id",
        "file_id",
        "user_id"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "format": "uuid"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "download_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    }
  }
}
