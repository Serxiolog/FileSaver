{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "file.created",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "file.created"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_type",
        "created_at",
        "file_id",
        "original_name",
        "owner_id",
        "size_bytes",
        "storage_key"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "format": "uuid"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "original_name": {
          "type": "string"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_type": {
          "type": "string"
        },
        "storage_key": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
